pipeline {
  agent any

  environment {
    BACKEND_IMAGE  = "wanderlust-backend"
    FRONTEND_IMAGE = "wanderlust-frontend"
    IMAGE_TAG      = "${BUILD_NUMBER}"
    API_PATH       = "http://localhost:5000"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build backend image') {
      steps {
        sh 'docker build -t $BACKEND_IMAGE:$IMAGE_TAG backend'
      }
    }

    stage('Build frontend image') {
      steps {
        sh 'docker build -t $FRONTEND_IMAGE:$IMAGE_TAG --build-arg VITE_API_PATH=$API_PATH frontend'
      }
    }
  }
}